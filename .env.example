# UniHub Environment Variables
# Copy this file to .env and fill in your own values.
# .env is ignored by git — never commit real secrets.

# Database — SQLite file for local development.
# The path is relative to the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Better Auth — secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Origin the app is served from. The dev server runs on port 8080.
BETTER_AUTH_URL="http://localhost:8080"

# App
VITE_APP_URL="http://localhost:8080"

# WhatsApp Business number in international format (e.g., 254700000000 for Kenya)
VITE_WHATSAPP_NUMBER=254700000000

# Optional: Custom WhatsApp message
VITE_WHATSAPP_MESSAGE=Hi%20UniHub%2C%20I%27d%20like%20help%20finding%20verified%20student%20housing

# Admin emails (comma-separated) — the allowlist for the admin area.
VITE_ADMIN_EMAILS=admin@unihub.ke
