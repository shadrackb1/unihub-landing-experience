// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
  UNIVERSITY_ADMIN
  VIEWER
}

enum LandlordStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ListingCategory {
  HOSTEL
  BEDSITTER
  SINGLE_ROOM
  STUDIO
  SHARED_APARTMENT
}

enum ListingStatus {
  AVAILABLE
  RENTED
  HIDDEN
  PENDING
  PUBLISHED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  password      String?   // hashed with bcrypt
  role          UserRole  @default(TENANT)
  image         String?
  // Fields required by the Better Auth admin plugin (ban / unban).
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  landlordProfile LandlordProfile?
  listings        Listing[]
  favorites       Favorite[]
  sessions        Session[]
  accounts        Account[]
}

model LandlordProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  phone              String
  whatsappNumber     String
  nationalId         String?
  targetCampuses     String        // JSON string array
  estimatedProperties Int
  status             LandlordStatus @default(PENDING)
  reviewNote         String?
  consentGivenAt     DateTime      @default(now())
  consentVersion     String        @default("2026-07-01")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  listings Listing[]
}

model Listing {
  id              String          @id @default(cuid())
  title           String
  description     String
  price           Int             // in cents (KES)
  deposit         Int             // in cents (KES)
  category        ListingCategory
  location        String
  latitude        Float?
  longitude       Float?
  images          String          // JSON string array
  amenities       String          // JSON string array
  genderRestriction String?       // none, male_only, female_only
  hasWifi         Boolean         @default(false)
  hasWater        Boolean         @default(false)
  videoUrl        String?
  status          ListingStatus   @default(AVAILABLE)
  isVerified      Boolean         @default(false)
  reviewNote      String?
  featured        Boolean         @default(false)
  inquiries       Int             @default(0)
  // Boost state, moved here from the retired Firestore listing documents.
  adStatus        String          @default("inactive")
  adPlan          String?
  adExpiresAt     DateTime?
  landlordId      String
  landlord        LandlordProfile @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  university      String?
  distanceFromCampus String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model University {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  logoUrl         String?
  location        String
  contactEmail    String?
  contactPhone    String?
  description     String
  verified        Boolean   @default(false)
  adminUserId     String?
  status          String    @default("active")
  foundedYear     Int?
  studentCount    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hostels Hostel[]
}

model Hostel {
  id              String        @id @default(cuid())
  universityId    String
  university      University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name            String
  location        String
  description     String
  hostelType      String        // boys, girls, mixed
  images          String        // JSON string array
  amenities       String        // JSON string array
  wardenName      String?
  wardenPhone     String?
  wardenEmail     String?
  status          String        @default("active")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rooms HostelRoom[]
}

model HostelRoom {
  id              String    @id @default(cuid())
  hostelId        String
  hostel          Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  roomNumber      String
  bedNumber       String?
  roomType        String    // single, shared_double, shared_quad, shared_open
  pricePerMonth   Int?
  pricePerSemester Int?
  pricePerYear    Int?
  status          String    @default("available")
  currentOccupants Int      @default(0)
  maxOccupants    Int
  occupancyPercentage Float @default(0)
  amenities       String    // JSON string array
  features        String    // JSON string array
  availableFrom   DateTime?
  availableUntil  DateTime?
  bookingDeadline DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Apartment {
  id              String    @id @default(cuid())
  name            String
  location        String
  description     String
  address         String
  latitude        Float?
  longitude       Float?
  amenities       String    // JSON string array
  images          String    // JSON string array
  agentId         String
  ownerType       String    // individual, company
  ownerName       String?
  contactEmail    String?
  contactPhone    String?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rooms Room[]
}

model Room {
  id              String     @id @default(cuid())
  apartmentId     String
  apartment       Apartment  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  roomNumber      String
  roomType        String     // single, double, bedsitter, studio, one_bedroom, two_bedroom
  price           Int
  deposit         Int?
  description     String
  features        String     // JSON string array
  images          String     // JSON string array
  status          String     @default("available")
  maxOccupants    Int
  squareMeters    Float?
  availabilityDate DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// Better Auth tables
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  // Set by the Better Auth admin plugin when an administrator impersonates a user.
  impersonatedBy String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  idToken           String?
  password          String? // for email/password provider
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([providerId, accountId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  identifier String
  token      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([identifier, token])
}

// Verification table used by Better Auth for email verification and password
// reset tokens. It is required by the authentication layer at runtime.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Consent capture (Data Protection Act, 2019 s.32; General Regulations, 2021
// reg. 4). One row per purpose, per person. Purposes are never bundled: a
// row exists only for a purpose the person actually ticked.
// ---------------------------------------------------------------------------

enum ConsentPurpose {
  IDENTITY_VERIFICATION
  LISTING_PUBLICATION
  PUBLIC_CONTACT_DETAILS
  PLATFORM_COMMUNICATIONS
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

model ConsentRecord {
  id             String         @id @default(cuid())
  userId         String? // Better Auth user id when the person is signed in
  email          String
  name           String
  purpose        ConsentPurpose
  purposeText    String // the exact wording shown to the person at the time
  wordingVersion String // version of that wording (v1.0)
  /// The consent declaration statements that were ticked when this record was
  /// written, as comma separated ids. Kept so the record shows exactly what
  /// the person agreed to, not only which purpose it was filed under.
  acknowledgedItems String?
  status         ConsentStatus  @default(GRANTED)
  grantedAt      DateTime
  withdrawnAt    DateTime?
  source         String         @default("consent-screen")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([email])
  @@index([purpose])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Records extracted from the public university hostel-notice source file.
// Kept in the same relational data layer so they can be imported, exported,
// searched, filtered and reported on.
// ---------------------------------------------------------------------------

model ExtractedHostelRecord {
  id         String   @id @default(cuid())
  hostelName String
  campus     String
  category   String
  rentKsh    Int
  capacity   Int
  distanceKm Float?
  sourceFile String
  sourceLine String
  confidence Float?
  importedAt DateTime @default(now())

  @@unique([hostelName, campus])
  @@index([campus])
}

// ---------------------------------------------------------------------------
// Site content managed from the admin site builder. One row (`global`) holds
// the hero copy, the featured listings, the theme, the feature flags and the
// team shown on the public site. JSON columns keep the shape identical to the
// SiteSettings type the marketing pages already consume.
// ---------------------------------------------------------------------------

model SiteSettings {
  id                 String   @id @default("global")
  heroTitle          String
  heroSubtitle       String
  heroImage          String?
  ctaText            String
  featuredProperties String   @default("[]") // JSON string array of listing ids
  theme              String   @default("{}") // JSON of theme tokens
  features           String   @default("{}") // JSON of feature flags
  teamMembers        String   @default("[]") // JSON string array of team members
  updatedBy          String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}